<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Consolonia.Sandbox"
        Title="{x:Static local:SandboxText.MainWindowTitle}"
        x:Class="Consolonia.Sandbox.MainWindow">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="1">
        <TextBlock TextWrapping="Wrap"
                   Text="{x:Static local:SandboxText.Description}" />
        <TextBlock Text="{x:Static local:SandboxText.BackgroundWelcome}"
                   HorizontalAlignment="Center" />
        <Button Content="{x:Static local:SandboxText.ShowModalButton}"
                Click="OnShowModalClick"
                HorizontalAlignment="Center" />
        <Button Content="{x:Static local:SandboxText.ShowModal2Button}"
                Click="OnShowModalClick2"
                HorizontalAlignment="Center" />
    </StackPanel>
</Window>
